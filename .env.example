# ==============================================================================
# WeCrew Technologies Private Limited
# Environment Configuration (.env.example)
# Copy this file to .env (or .env.local for local development)
# ==============================================================================

# Public Site URL
VITE_SITE_URL=https://wecrew.in

# ------------------------------------------------------------------------------
# FormSubmit Email Delivery Configuration
# ------------------------------------------------------------------------------
# The contact form sends inquiries directly to support@wecrew.in via FormSubmit AJAX.
# Endpoint: https://formsubmit.co/ajax/support@wecrew.in
#
# IMPORTANT ACTIVATION NOTE:
# The first time a contact form submission is sent to support@wecrew.in,
# FormSubmit will send an activation email to support@wecrew.in.
# The recipient MUST click the "Activate Form" button in that confirmation email.
# Subsequent submissions will then immediately deliver to the inbox without any captcha.
VITE_FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/support@wecrew.in
VITE_FORMSUBMIT_EMAIL=support@wecrew.in
